# Multi-stage build for React Frontend
FROM node:18-alpine as builder

WORKDIR /app

# Build-time configuration. Both are baked into the bundle by react-scripts:
#   PUBLIC_URL              — where the app is mounted (e.g. /ai-jura). Sets
#                             asset URLs and the SPA's runtime base.
#   REACT_APP_API_BASE_URL  — prepended to every axios call (see index.js).
# Defaults keep root-mounted, same-origin behaviour for vanilla `docker build`.
ARG PUBLIC_URL=""
ARG REACT_APP_API_BASE_URL=""
ENV PUBLIC_URL=$PUBLIC_URL
ENV REACT_APP_API_BASE_URL=$REACT_APP_API_BASE_URL

# The repo is an npm workspace ("workspaces": ["frontend"]) — the canonical
# lockfile lives at the repo root, not in frontend/. Copy both manifests so
# `npm ci` can resolve the workspace correctly.
COPY package.json package-lock.json .npmrc ./
COPY frontend/package.json ./frontend/

# Install across the workspace
RUN npm ci --prefer-offline --no-audit

# Copy the rest of the frontend source
COPY frontend/ ./frontend/

# Build the production bundle from the frontend workspace
WORKDIR /app/frontend
RUN npm run build

# Production stage with nginx
FROM nginx:alpine

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder (now under the frontend workspace path)
COPY --from=builder /app/frontend/build /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
