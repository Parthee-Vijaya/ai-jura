# Multi-stage build for React Frontend
#
# Repoet er et npm-WORKSPACE (root package.json -> workspaces: ["frontend"]).
# Den autoritative lockfil er rodens package-lock.json — frontend/ har en
# forældet standalone-lockfil som npm ci afviser ("not in sync"). Derfor
# installeres fra roden (workspace-aware), præcis som i lokal dev.
FROM node:18-alpine as builder

WORKDIR /repo

# Build-time configuration. Both are baked into the bundle by react-scripts:
#   PUBLIC_URL              — where the app is mounted (e.g. /ai-jura). Sets
#                             asset URLs and the SPA's runtime base.
#   REACT_APP_API_BASE_URL  — prepended to every axios call (see index.js).
# Defaults keep root-mounted, same-origin behaviour for vanilla `docker build`.
ARG PUBLIC_URL=""
ARG REACT_APP_API_BASE_URL=""
ENV PUBLIC_URL=$PUBLIC_URL
ENV REACT_APP_API_BASE_URL=$REACT_APP_API_BASE_URL

# Workspace-manifester først (layer-cache: deps geninstalleres kun ved ændring).
# Rodens lockfil er autoritativ; frontend/ har en forældet standalone-lockfil.
COPY package.json package-lock.json .npmrc ./
COPY frontend/package.json ./frontend/

# Install dependencies (hoistes til /repo/node_modules)
RUN npm ci --prefer-offline --no-audit

# Copy frontend source
COPY frontend/ ./frontend/

# public/mockups er et symlink til ../../mockups (dev-bekvemmelighed) — målet
# ligger uden for frontend/ og findes ikke i imaget, så CRA's public-kopiering
# fejler med ENOENT. Design-mockups hører ikke til i produktions-bundtet.
RUN rm -f ./frontend/public/mockups

# Build production bundle (react-scripts løses via hoistede node_modules)
RUN npm run build --workspace=frontend

# Production stage with nginx
FROM nginx:alpine

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /repo/frontend/build /usr/share/nginx/html

# Expose port 80
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
